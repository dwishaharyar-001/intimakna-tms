# PostgreSQL (Prisma)
# DATABASE_URL = koneksi yang dipakai APLIKASI.
#   - Lokal  : postgresql://intimakna:SANDI@localhost:5433/intimakna_tms?schema=public
#   - Supabase (pooler, untuk aplikasi serverless/VPS):
#     postgresql://postgres.<ref>:SANDI@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DATABASE_URL="postgresql://intimakna:SANDI@localhost:5433/intimakna_tms?schema=public"

# DIRECT_URL = koneksi LANGSUNG (tanpa pooler), khusus migrasi/seed/transfer data.
#   - Lokal  : sama seperti DATABASE_URL di atas
#   - Supabase: postgresql://postgres:SANDI@db.<ref>.supabase.co:5432/postgres?sslmode=require
DIRECT_URL="postgresql://intimakna:SANDI@localhost:5433/intimakna_tms?schema=public"

# Kunci JWT — WAJIB diganti dengan nilai acak yang panjang (mis. `openssl rand -base64 48`)
JWT_SECRET="ganti-dengan-nilai-acak-panjang"

# Origin web yang diizinkan (CORS) — pisahkan dengan koma bila lebih dari satu
WEB_ORIGIN="http://localhost:3000"

# Port API
PORT=4000

# Opsional: sandi untuk akun demo saat menjalankan `npm run seed`.
# Bila tidak diisi, seed membuat sandi acak dan menampilkannya sekali di terminal.
# SEED_PASSWORD=""
